{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@public/*": ["./public/*"],
			"@type/*": ["./src/lib/type/*"],
			"@images": ["./src/lib/components/images/index"],
			"@organisms": ["./src/lib/components/organisms/index"],
			"@molecules": ["./src/lib/components/molecules/index"],
			"@atoms": ["./src/lib/components/atoms/index"],
			"@hooks/*": ["./src/lib/hooks/*"],
			"@data/*": ["./src/data/*"],
			"@auth": ["./src/lib/auth"],
			"@env/*": ["./src/lib/env/*"],
			"@db": ["./src/lib/db/index"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts",
		"src/seed.ts"
	],
	"exclude": ["node_modules"]
}
